pipeline {
    // Top-level agent runs all stages inside this Maven container by default
    agent {
        docker {
            image 'maven:3.8.6-openjdk-17-slim'
            args '-v /root/.m2:/root/.m2' // Cache Maven dependencies
        }
    }
    
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        
        stage('Build') {
            steps {
                sh 'mvn clean compile'
            }
        }
        
        stage('Test') {
            steps {
                sh 'mvn test'
            }
            post {
                always {
                    junit 'target/surefire-reports/*.xml'
                }
            }
        }
        
        stage('Package') {
            steps {
                sh 'mvn package -DskipTests'
            }
        }
        
        stage('Containerize') {
            // Override the agent just for this stage to use the Docker CLI
            agent {
                docker {
                    image 'docker:latest'
                    // Mount the host's Docker socket so the CLI can execute builds
                    args '-v /var/run/docker.sock:/var/run/docker.sock'
                }
            }
            steps {
                sh "docker build -t my-springboot-app:${env.BUILD_ID} ."
            }
        }
    }
}