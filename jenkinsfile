pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                // Pulls the code from the repository configured in the Jenkins job
                checkout scm
            }
        }
        
        stage('Test Docker Build') {
            steps {
                script {
                    // Create a unique tag using the Jenkins build number
                    def testImageTag = "repo-build-test:${env.BUILD_ID}"
                    
                    echo "Building Docker image: ${testImageTag}..."
                    
                    // Executes the build using the Dockerfile in the root of your repo
                    sh "docker build -t ${testImageTag} ."
                    
                    echo "Build successful! Cleaning up..."
                    
                    // Removes the newly built image from your Mac to save disk space
                    sh "docker rmi ${testImageTag}"
                }
            }
        }
    }
}