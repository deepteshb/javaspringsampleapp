pipeline {
    agent { 
        label 'built-in' 
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '2'))
        disableConcurrentBuilds()
    }

    environment {
        IMAGE_NAME = 'my-springboot-app'
        IMAGE_TAG  = "${env.BUILD_ID}"
    }

    stages {
        stage('Matrix Build') {
            matrix {
                axes {
                    axis {
                        name 'JDK_VERSION'
                        values '11', '17', '25', '27'
                    }
                }
                stages {
                    stage('Checkout') {
                        steps {
                            ws("jdk_workspace_${JDK_VERSION}") {
                                checkout scm
                            }
                        }
                    }
                    
                    stage('Compile JAR') {
                        steps {
                            ws("jdk_workspace_${JDK_VERSION}") {
                                script {
                                    env."BUILD_PASSED_${JDK_VERSION}" = 'false'
                                    
                                    catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                                        echo "Building Spring Boot app with JDK ${JDK_VERSION}..."
                                        
                                        // The Maven cache volume is now strictly isolated per JDK version
                                        sh """
                                            docker run --rm \\
                                              -v "${WORKSPACE}:/workspace" \\
                                              -v "${HOME}/.m2_jdk_${JDK_VERSION}:/root/.m2" \\
                                              -w /workspace \\
                                              maven:3.9-eclipse-temurin-${JDK_VERSION} \\
                                              mvn -B clean package
                                        """
                                        
                                        env."BUILD_PASSED_${JDK_VERSION}" = 'true'
                                    }
                                }
                            }
                        }
                    }

                    stage('Build Image') {
                        when {
                            environment name: "BUILD_PASSED_${JDK_VERSION}", value: 'true'
                        }
                        steps {
                            ws("jdk_workspace_${JDK_VERSION}") {
                                echo "JDK ${JDK_VERSION} passed! Building its container image..."
                                sh """
                                    docker build \\
                                      --build-arg JAVA_VERSION=${JDK_VERSION} \\
                                      -t ${IMAGE_NAME}:${IMAGE_TAG}-jdk${JDK_VERSION} .
                                """
                            }
                        }
                    }
                }
            }
        }
    }
    
    post {
        always {
            echo 'Cleaning up all images generated by this matrix run...'
            script {
                def versions = ['11', '17', '25', '27']
                for (v in versions) {
                    sh "docker rmi ${IMAGE_NAME}:${IMAGE_TAG}-jdk${v} || true"
                }
            }
        }
    }
}