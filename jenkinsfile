pipeline {
    agent any

    options {
        // Automatically discards old builds and only keeps the latest 2
        buildDiscarder(logRotator(numToKeepStr: '2'))
        
        // Optional but recommended: prevents multiple builds from running at the same time
        disableConcurrentBuilds()
    }

    environment {
        // Define your image name and tag variables here
        IMAGE_NAME = 'my-springboot-app'
        IMAGE_TAG  = "${env.BUILD_ID}"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        
        stage('Build Spring Boot JAR') {
            steps {
                echo 'Compiling and packaging the Spring Boot application...'
                sh '''
                    docker run --rm \
                      -v "${WORKSPACE}:/workspace" \
                      -v "${HOME}/.m2:/root/.m2" \
                      -w /workspace \
                      maven:3.9.9-eclipse-temurin-17 \
                      mvn -B clean package -DskipTests
                '''
            }
        }
        
        stage('Build Docker Image') {
            steps {
                echo "Building Docker image: ${IMAGE_NAME}:${IMAGE_TAG}..."
                // Builds the image using the Dockerfile in your repository root
                sh "docker build -t ${IMAGE_NAME}:${IMAGE_TAG} ."
            }
        }
    }
    
    post {
        always {
            echo 'Cleaning up the local Docker image to free up disk space...'
            sh "docker rmi ${IMAGE_NAME}:${IMAGE_TAG} || true"
        }
        success {
            echo 'Build successful! Archiving the JAR file...'
            archiveArtifacts artifacts: 'target/*.jar', fingerprint: true
        }
    }
}