pipeline {
    
    //Added agent configuration to use a specific Docker agent for the build.
     agent {
        label 'docker-agent01'
    }
    
    tools {
        // Ensure these tool names match your Jenkins global tool configuration
        maven 'maven3' 
        jdk 'jdk17'
    }
    
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        
        stage('Build') {
            steps {
                    sh 'mvn clean compile'
                }
        }
        
        stage('Test') {
            steps {
                sh 'mvn test'
            }
            post {
                always {
                    junit 'target/surefire-reports/*.xml'
                }
            }
        }
        
        stage('Package') {
            steps {
                sh 'mvn package -DskipTests'
            }
        }
        
stage('Containerize') {
            // Spin up a container that already has Docker installed just for this stage
            agent {
                docker {
                    image 'docker:latest'
                    // Mount the host's Docker socket so the CLI can execute builds
                    args '-v /var/run/docker.sock:/var/run/docker.sock'
                }
            }
            steps {
                sh "docker build -t my-springboot-app:${env.BUILD_ID} ."
            }
        }
    }
}