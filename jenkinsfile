pipeline {
    agent { 
        label 'built-in' 
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '2'))
        disableConcurrentBuilds()
    }

    environment {
        IMAGE_NAME = 'my-springboot-app'
        IMAGE_TAG  = "${env.BUILD_ID}"
    }

    stages {
        stage('Matrix Build & Package') {
            matrix {
                axes {
                    axis {
                        name 'JDK_VERSION'
                        values '11', '17', '25', '27'
                    }
                }
                stages {
                    stage('Checkout') {
                        steps {
                            // Assigns a unique folder on your Mac for each JDK to prevent file collisions
                            ws("${WORKSPACE}_jdk_${JDK_VERSION}") {
                                checkout scm
                            }
                        }
                    }
                    
                    stage('Compile & Test') {
                        steps {
                            ws("${WORKSPACE}_jdk_${JDK_VERSION}") {
                                script {
                                    // 1. Initialize a success flag for this specific JDK version
                                    env."BUILD_PASSED_${JDK_VERSION}" = 'false'
                                    
                                    try {
                                        echo "Building Spring Boot app with JDK ${JDK_VERSION}..."
                                        sh """
                                            docker run --rm \\
                                              -v "${WORKSPACE}_jdk_${JDK_VERSION}:/workspace" \\
                                              -v "${HOME}/.m2:/root/.m2" \\
                                              -w /workspace \\
                                              maven:3.9-eclipse-temurin-${JDK_VERSION} \\
                                              mvn -B clean package
                                        """
                                        // 2. If the build succeeds without crashing, flip the flag to true
                                        env."BUILD_PASSED_${JDK_VERSION}" = 'true'
                                        
                                    } catch (Exception e) {
                                        // 3. Catching the error prevents Jenkins from failing the whole pipeline
                                        echo "WARNING: Build failed for JDK ${JDK_VERSION}. Ignoring and moving on."
                                    }
                                }
                            }
                        }
                    }

                    stage('Build Docker Image') {
                        // 4. This ensures Docker only builds if the Maven step above was successful
                        when {
                            environment name: "BUILD_PASSED_${JDK_VERSION}", value: 'true'
                        }
                        steps {
                            ws("${WORKSPACE}_jdk_${JDK_VERSION}") {
                                echo "JDK ${JDK_VERSION} passed! Building its container image..."
                                
                                // We tag the image with the JDK version so they don't overwrite each other,
                                // and pass the JDK version inside the Dockerfile using a build-arg.
                                sh """
                                    docker build \\
                                      --build-arg JAVA_VERSION=${JDK_VERSION} \\
                                      -t ${IMAGE_NAME}:${IMAGE_TAG}-jdk${JDK_VERSION} .
                                """
                            }
                        }
                    }
                }
            }
        }
    }
    
    post {
        always {
            echo 'Cleaning up all images generated by this matrix run...'
            script {
                def versions = ['11', '17', '25', '27']
                for (v in versions) {
                    sh "docker rmi ${IMAGE_NAME}:${IMAGE_TAG}-jdk${v} || true"
                }
            }
        }
    }
}