pipeline {
    // Runs directly on any available Jenkins node
    agent any 
    
    // Required again since we are no longer inside the Maven container
    tools {
        maven 'maven3' 
        jdk 'jdk17'
    }
    
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        
        stage('Build') {
            steps {
                //with tools
                withEnv(["JAVA_HOME=${tool 'jdk17'}"])
                sh 'mvn clean compile'
            }
        }
        
        stage('Test') {
            steps {
                sh 'mvn test'
            }
            post {
                always {
                    junit 'target/surefire-reports/*.xml'
                }
            }
        }
        
        stage('Package') {
            steps {
                sh 'mvn package -DskipTests'
            }
        }
        
        stage('Containerize') {
            steps {
                agent {
                    docker {
                        image 'docker:latest'
                        args '-v /var/run/docker.sock:/var/run/docker.sock'
                    }
                }
                sh 'docker build -t myapp:latest .'
            }
        }
    }
}