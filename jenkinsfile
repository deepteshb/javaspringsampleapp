pipeline {
    agent { 
        label 'built-in' 
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '2'))
        disableConcurrentBuilds()
    }

    environment {
        IMAGE_NAME = 'my-springboot-app'
        IMAGE_TAG  = "${env.BUILD_ID}"
    }

    stages {
        stage('Checkout Main Workspace') {
            steps {
                checkout scm
            }
        }
        
        stage('Parallel Test Matrix') {
            matrix {
                axes {
                    axis {
                        name 'JDK_VERSION'
                        // Defines the 4 parallel versions to test
                        values '11', '17', '25', '27'
                    }
                }
                stages {
                    stage('Test') {
                        steps {
                            // Creates a separate, isolated workspace directory for each JDK
                            // e.g., /Users/<name>/.jenkins/workspace/my-job_jdk_11
                            ws("${WORKSPACE}_jdk_${JDK_VERSION}") {
                                
                                // Pull the code into this isolated directory
                                checkout scm
                                
                                echo "Running tests against JDK ${JDK_VERSION}..."
                                
                                // The Matrix axis variables are automatically injected as bash environment variables
                                sh '''
                                    docker run --rm \
                                      -v "${WORKSPACE}:/workspace" \
                                      -v "${HOME}/.m2:/root/.m2" \
                                      -w /workspace \
                                      maven:3.9-eclipse-temurin-${JDK_VERSION} \
                                      mvn -B test
                                '''
                            }
                        }
                    }
                }
            }
        }
        
        stage('Build Spring Boot JAR') {
            steps {
                echo 'Compiling and packaging the application (using baseline Java 17)...'
                // This uses the main workspace from the first stage
                sh '''
                    docker run --rm \
                      -v "${WORKSPACE}:/workspace" \
                      -v "${HOME}/.m2:/root/.m2" \
                      -w /workspace \
                      maven:3.9-eclipse-temurin-17 \
                      mvn -B clean package -DskipTests
                '''
            }
        }
        
        stage('Build Docker Image') {
            steps {
                echo "Building Docker image: ${IMAGE_NAME}:${IMAGE_TAG}..."
                sh "docker build -t ${IMAGE_NAME}:${IMAGE_TAG} ."
            }
        }
    }
    
    post {
        always {
            echo 'Cleaning up the local Docker image...'
            sh "docker rmi ${IMAGE_NAME}:${IMAGE_TAG} || true"
        }
        success {
            echo 'Build successful! Archiving the JAR file...'
            archiveArtifacts artifacts: 'target/*.jar', fingerprint: true
        }
    }
}