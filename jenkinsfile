pipeline {
    // Runs directly on any available Jenkins node
    agent any 
    
    // Required again since we are no longer inside the Maven container
    tools {
        maven 'maven3' 
        jdk 'jdk17'
    }
    
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        
        stage('Build') {
            steps {
                //with tools
                withEnv(["JAVA_HOME=${tool 'jdk17'}"])
                sh 'mvn clean compile'
            }
        }
        
        stage('Test') {
            steps {
                sh 'mvn test'
            }
            post {
                always {
                    junit 'target/surefire-reports/*.xml'
                }
            }
        }
        
        stage('Package') {
            steps {
                sh 'mvn package -DskipTests'
            }
        }
        
        stage('Containerize') {
            steps {
                // Note: The Jenkins node executing this job MUST have Docker installed 
                // on its operating system for this step to work.
                sh "docker build -t my-springboot-app:${env.BUILD_ID} ."
            }
        }
    }
}